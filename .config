# 1. 锁定核心硬件平台 (联发科 Filogic 820)
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y

# 2. 精准锁定你的真实机型 (爱快 IK-Q3000)
CONFIG_TARGET_mediatek_filogic_DEVICE_ikuai_q3000=y

# 3. 彻底根除 IPv6 (防假连通、防微信图片转圈)
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set

# 4. 救命神器：SQM QoS (拯救百兆小水管延迟)
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y

# 5. 注入 iStore 灵魂 (傻瓜化商店与美化)
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-theme-argon=y

# 6. 实用小工具 (网页版命令行终端与自动端口映射)
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
